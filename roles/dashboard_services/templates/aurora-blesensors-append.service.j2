[Unit]
Description=Aurora enclosure BLE temperature and humidity Zarr append
After=network-online.target aurora-blesensors-source-sync.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
WorkingDirectory={{ aurora_app_dir }}
EnvironmentFile=/etc/aurora-dashboard.env
ExecStart=/usr/bin/flock --nonblock {{ aurora_state_root }}/blesensors-append.lock {{ aurora_venv }}/bin/python append_new_blesensors_to_zarr.py --root {{ aurora_paths.raw_blesensors }} --zarr {{ aurora_zarr.blesensors }}
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
