                "--lookback-days", "30",
                "--max-power-age-minutes", "20",
{% if aurora_cl61_automation_shadow_enabled | bool %}
                "--enable-automation-shadow",
                "--automation-intent-output", str(staging / "cl61_automation_intent.json"),
                "--automation-status-output", str(staging / "cl61_automation_status.json"),
                "--automation-history-output", str(CL61_HISTORY),
                "--automation-environment", {{ aurora_cl61_automation_environment | to_json }},
