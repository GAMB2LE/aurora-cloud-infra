                    "sha256": products[product_name]["sha256"],
                    "productIdentityID": products[product_name].get("forecastIdentityID")
                    or products[product_name].get("publicationSignature")
                    or products[product_name].get("sourceCycleSetID")
                    or products[product_name]["sha256"],
                    "forecastIdentityID": components[label]["forecastIdentityID"],
                    "sourceCycleSetID": components[label]["sourceCycleSetID"],
                    "upstreamSourceManifestDigest": components[label][
                        "upstreamSourceManifestDigest"
                    ],
                    "sourceCycleUTC": components[label]["cycleUTC"],
                    "socAnchorUTC": components[label]["socAnchorUTC"],
                }
                for label, product_name in {
                    "deterministic": "deterministicForecast",
                    "planning": "planningForecast",
                    "ensemble": "ensembleForecast",
                }.items()
            }
            source_manifest_digest = canonical_json_digest(source_manifest_products)
            generation = {
                "schemaVersion": 1,
                "status": "complete",
                "requestedAt": requested_at,
                "dataUpdatedAt": completed_at,
                "updatedAt": completed_at,
                "controlAuthority": "advisory_only",
                "cl61ActuationEnabled": False,
                "components": components,
                "products": products,
                "sourceManifestProducts": source_manifest_products,
                "sourceManifestDigest": f"sha256:{source_manifest_digest}",
                **provenance,
            }
            atomic_json(staging / "generation.json", generation)
            # Every completed bundle, including its exact ENS snapshot, is
            # non-writable before any public pointer can reference it.
            make_tree_read_only(staging)
            os.replace(staging, final)
            atomic_current_symlink(final, CURRENT_BUNDLE)
            if provenance["independentCycle"]:
                atomic_current_symlink(final, INDEPENDENT_BUNDLE)
            if PUBLICATION_ACTIVE:
                atomic_current_symlink(final, ACTIVE_BUNDLE)
            publish_status(
                "current",
                requestedAt=requested_at,
                dataUpdatedAt=completed_at,
                staleReason=None,
                failedStage=None,
                firstFailureAt=None,
                lastFailureStage=None,
                lastFailureDetail=None,
                failureCount=0,
                activeGeneration=generation_id,
                **provenance,
            )
            retain_recent_generations()
        except Exception:
            if staging.exists():
                quarantine = BUNDLE_ROOT / "quarantine"
                quarantine.mkdir(parents=True, exist_ok=True)
                staging.rename(quarantine / f"failed-{generation_id}")
            raise

    # Quicklook warming is deliberately outside the atomic publication. A
    # rendering failure cannot invalidate the already complete API generation.
    subprocess.run(
        [str(PYTHON), "generate_power_quicklooks.py", "--prewarm-only", "--skip-display-refresh"],
        cwd=APP_DIR,
        check=False,
    )


def main() -> int:
    parser = argparse.ArgumentParser()
    actions = parser.add_mutually_exclusive_group(required=True)
    actions.add_argument("--quarantine-incoming", type=Path)
    actions.add_argument("--capture-issue", type=Path)
    actions.add_argument("--verify-issue", type=Path)
    actions.add_argument("--print-issue-anchor", type=Path)
    actions.add_argument("--print-forecast-anchor", type=Path)
    actions.add_argument("--verify-bundle", type=Path)
    actions.add_argument("--publish", action="store_true")
    actions.add_argument(
        "--begin-attempt", choices=("ecmwf_cycle", "cached_reanchor")
    )
    actions.add_argument("--record-failure")
    parser.add_argument("--forecast-source", type=Path, default=CURRENT_ISSUE)
    parser.add_argument("--allow-cached-reanchor", action="store_true")
    args = parser.parse_args()
    try:
        if args.quarantine_incoming is not None:
            quarantine_incoming(args.quarantine_incoming)
        elif args.capture_issue is not None:
            capture_issue(args.capture_issue)
        elif args.verify_issue is not None:
            verify_issue_snapshot(args.verify_issue)
        elif args.print_issue_anchor is not None:
            print_issue_anchor(args.print_issue_anchor)
        elif args.print_forecast_anchor is not None:
            print_forecast_anchor(args.print_forecast_anchor)
        elif args.verify_bundle is not None:
            verify_bundle(args.verify_bundle)
        elif args.begin_attempt is not None:
            begin_attempt(args.begin_attempt)
        elif args.publish:
            publish_bundle(
                args.forecast_source,
                allow_cached_reanchor=args.allow_cached_reanchor,
            )
        else:
            mark_failure(str(args.record_failure))
        return 0
    except Exception as exc:
        stage = (
            "issue_snapshot_preflight"
            if args.quarantine_incoming is not None
            else "issue_capture"
            if args.capture_issue is not None
            else "issue_verification"
            if args.verify_issue is not None
            else "issue_verification"
            if args.print_issue_anchor is not None
            else "forecast_anchor_verification"
            if args.print_forecast_anchor is not None
            else "bundle_activation_verification"
            if args.verify_bundle is not None
            else "bundle_publication"
            if args.begin_attempt is None
            else "attempt_initialization"
        )
        mark_failure(stage, str(exc))
        print(f"{stage} failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
