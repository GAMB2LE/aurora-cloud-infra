[Unit]
Description=Aurora isolated v12 hybrid power-forecast candidate
After=network-online.target aurora-power-soc-forecast.service aurora-power-forecast-publish.service
Wants=network-online.target
ConditionPathExists={{ aurora_power_forecast_bundle_independent_root }}/generation.json
ConditionPathExists={{ aurora_zarr.power_soc_forecast_archive }}
ConditionPathExists={{ aurora_zarr.power }}
{% if aurora_power_paired_evaluation_enabled | bool %}
# Paired archive scoring is evidence-only. Run it whether the candidate
# succeeds or fails, without making forecast publication depend on it.
OnSuccess=aurora-power-prod-dev-evaluation.service
OnFailure=aurora-power-prod-dev-evaluation.service
{% endif %}

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
WorkingDirectory={{ aurora_app_dir }}
EnvironmentFile=/etc/aurora-dashboard.env
# A condition skip is not a candidate failure and does not trigger the paired
# evaluator. The launcher records an explicit deferred status and fails closed
# if systemd cannot prove that the independent model evaluator is idle.
ExecCondition={{ aurora_venv }}/bin/python /usr/local/bin/aurora-power-v12-candidate-launch --require-model-evaluation-idle
ExecStart=/usr/bin/flock --nonblock {{ aurora_power_v12_candidate_root }}/.runner.lock /usr/bin/timeout --signal=TERM --kill-after=30s 22m {{ aurora_venv }}/bin/python /usr/local/bin/aurora-power-v12-candidate-launch
Nice=19
CPUQuota=25%
CPUWeight=5
# The first isolated canary needs more than 512 MiB simply to read the
# site-level history.  Keep pressure below the hard 1.5 GiB ceiling without
# throttling useful progress before a lane can be evaluated.
MemoryHigh=1G
MemoryMax=1.5G
IOSchedulingClass=idle
OOMPolicy=stop
# Three sequential, isolated ablation lanes run at 25%% CPU.  Twenty-two
# minutes preserves a bounded development-only job while allowing all lanes
# to complete without relaxing its memory or scheduling isolation.
TimeoutStartSec=24min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths={{ aurora_app_dir }} {{ aurora_product_root }} {{ aurora_dev_product_root }} {{ aurora_raw_root }}
ReadWritePaths={{ aurora_power_v12_candidate_root }}
