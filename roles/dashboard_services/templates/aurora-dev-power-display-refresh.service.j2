[Unit]
Description=Refresh compact Power display products from mirrored Power data
After=network-online.target aurora-dev-live-pull@product-power.service aurora-power-operating-scenarios.service
Wants=network-online.target aurora-power-operating-scenarios.service
ConditionPathExists={{ aurora_zarr.power }}
{% if aurora_power_forecast_orchestration_enabled | bool %}
# Do not permit a manual legacy refresh to mutate an active generation through
# the atomic `current` symlink.
ConditionPathExists=!{{ aurora_power_forecast_bundle_current_root }}/generation.json
{% endif %}

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
WorkingDirectory={{ aurora_app_dir }}
EnvironmentFile=/etc/aurora-dashboard.env
ExecStart=/usr/bin/timeout --signal=TERM --kill-after=30s 12m /bin/bash -lc 'status=0; {{ aurora_venv }}/bin/python generate_power_display_summary.py || status=$?; {{ aurora_venv }}/bin/python generate_power_quicklooks.py --prewarm-only --skip-display-refresh; exit $status'
Nice=15
CPUQuota=100%
CPUWeight=10
MemoryHigh=3G
MemoryMax=4G
TimeoutStartSec=13min
