[Unit]
Description=Aurora Menapia flight display products
After=network-online.target aurora-menapia-flight-source-sync.service
Wants=network-online.target
ConditionPathExists={{ aurora_menapia_product_raw_root }}
ConditionPathExists={{ aurora_venv }}/bin/python

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
Environment=MPLCONFIGDIR={{ aurora_menapia_product_state_root }}/matplotlib
ExecStart={{ aurora_venv }}/bin/python /usr/local/bin/aurora-menapia-flight-products --raw-root {{ aurora_menapia_product_raw_root }} --product-root {{ aurora_menapia_product_root }} --quicklook-root {{ aurora_menapia_quicklook_root }} --state-path {{ aurora_menapia_product_state_path }} --campaign-start-day {{ aurora_menapia_product_campaign_start_day }}
TimeoutStartSec={{ aurora_menapia_product_timeout }}
UMask=0022
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
ReadOnlyPaths={{ aurora_menapia_product_raw_root }}
ReadWritePaths={{ aurora_menapia_product_root }} {{ aurora_menapia_quicklook_root }} {{ aurora_menapia_product_state_root }}
