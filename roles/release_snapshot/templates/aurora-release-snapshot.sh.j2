#!/usr/bin/env bash
set -euo pipefail

umask 077

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <target-release>" >&2
  exit 64
fi

snapshot_root={{ aurora_release_snapshot_root | quote }}
app_dir={{ aurora_app_dir | quote }}
service_user={{ aurora_service_user | quote }}
target_release=$1
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
snapshot_dir="${snapshot_root}/${timestamp}"
file_list="${snapshot_dir}/configuration-files.txt"

install -d -m 0700 "${snapshot_dir}"

{
  printf 'captured_at_utc=%s\n' "$(date -u +%FT%TZ)"
  printf 'target_release=%s\n' "${target_release}"
  printf 'app_dir=%s\n' "${app_dir}"
if runuser -u "${service_user}" -- git -C "${app_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # Run every Git operation as the checkout owner.  `git diff` may refresh
    # the index, so invoking it as root would leave a root-owned index and
    # block the next deliberately non-root deployment clean check.
    printf 'source_commit=%s\n' "$(runuser -u "${service_user}" -- git -C "${app_dir}" rev-parse HEAD)"
    printf 'source_describe=%s\n' "$(runuser -u "${service_user}" -- git -C "${app_dir}" describe --tags --always --dirty)"
    printf 'source_branch=%s\n' "$(runuser -u "${service_user}" -- git -C "${app_dir}" branch --show-current || true)"
  fi
  systemctl is-active aurora-dashboard.service || true
  systemctl is-active aurora-mobile-api.service || true
  systemctl is-enabled aurora-dashboard.service || true
  systemctl is-enabled aurora-mobile-api.service || true
} > "${snapshot_dir}/manifest.txt"

for unit in \
  aurora-dashboard.service \
  aurora-mobile-api.service \
  aurora-power-append.service \
  aurora-power-append.timer \
  aurora-pdu-append.service \
  aurora-pdu-append.timer \
  aurora-dev-live-pull@product-power.service \
  aurora-dev-live-pull-product-power.timer \
  aurora-power-soc-forecast.service \
  aurora-power-soc-forecast.timer \
  aurora-power-soc-forecast-learn.service \
  aurora-power-soc-forecast-learn.timer \
  aurora-power-soc-ensemble.service \
  aurora-power-soc-ensemble.timer \
  aurora-power-soc-planning-forecast.service \
  aurora-power-soc-planning-forecast.timer \
  aurora-power-operating-scenarios.service \
  aurora-power-operating-scenarios.timer \
  aurora-dev-power-display-refresh.service \
  aurora-dev-power-display-refresh.timer \
  aurora-power-quicklooks.service \
  aurora-power-quicklooks.timer \
  aurora-power-forecast-publish.service \
  aurora-power-v12-candidate.service \
  aurora-power-v12-candidate.timer \
  aurora-power-prod-dev-evaluation.service; do
  printf '%s\t%s\t%s\n' \
    "${unit}" \
    "$(systemctl is-enabled "${unit}" 2>/dev/null || true)" \
    "$(systemctl is-active "${unit}" 2>/dev/null || true)"
done > "${snapshot_dir}/service-states.tsv"

: > "${snapshot_dir}/worktree.patch"
: > "${snapshot_dir}/index.patch"
: > "${snapshot_dir}/untracked-files.txt"
if runuser -u "${service_user}" -- git -C "${app_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  runuser -u "${service_user}" -- git -C "${app_dir}" diff --binary > "${snapshot_dir}/worktree.patch"
  runuser -u "${service_user}" -- git -C "${app_dir}" diff --cached --binary > "${snapshot_dir}/index.patch"
  runuser -u "${service_user}" -- git -C "${app_dir}" ls-files --others --exclude-standard > "${snapshot_dir}/untracked-files.txt"
fi

{
  for path in \
    /etc/aurora-dashboard.env \
    /etc/aurora-mobile-api.token \
    /etc/nginx \
    "/home/${service_user}/.msmtprc"; do
    [[ -e "${path}" ]] && printf '%s\n' "${path#/}"
  done
  find /etc/systemd/system -maxdepth 1 -type f -name 'aurora-*' -print 2>/dev/null | sed 's#^/##'
  find /etc/systemd/system -maxdepth 1 -type d -name 'aurora-*.service.d' -print 2>/dev/null | sed 's#^/##'
} | sort -u > "${file_list}"

tar -C / -czf "${snapshot_dir}/configuration.tar.gz" -T "${file_list}"

# Bind checksums to the bytes actually archived, not to a second read of a
# potentially changing live file. Any tar read error is fatal above.
verification_root=$(mktemp -d /var/tmp/aurora-release-snapshot-verify.XXXXXX)
cleanup() {
  rm -rf -- "${verification_root}"
}
trap cleanup EXIT
tar -xzf "${snapshot_dir}/configuration.tar.gz" -C "${verification_root}"
(
  cd "${verification_root}"
  find . -type f -print0 | sort -z | xargs -0 -r sha256sum
) > "${snapshot_dir}/configuration.sha256"
cleanup
trap - EXIT

chmod 0600 "${snapshot_dir}"/*

(
  cd "${snapshot_dir}"
  sha256sum \
    configuration.tar.gz \
    configuration.sha256 \
    configuration-files.txt \
    index.patch \
    manifest.txt \
    service-states.tsv \
    untracked-files.txt \
    worktree.patch > snapshot.sha256
)
chmod 0600 "${snapshot_dir}/snapshot.sha256"
printf '%s\n' "${snapshot_dir}"
