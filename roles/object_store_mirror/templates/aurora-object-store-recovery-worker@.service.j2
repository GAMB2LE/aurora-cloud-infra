[Unit]
Description=Verify one queued Aurora archive family (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ object_store_rclone_config }}

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
UMask=0007
Environment=XDG_CACHE_HOME={{ object_store_cache_root }}
LoadCredential=s3-rclone-config:{{ object_store_rclone_config }}
LoadCredential=gws-key:{{ gws_ssh_private_key }}
LoadCredential=gws-known-hosts:/home/{{ aurora_service_user }}/.ssh/known_hosts
ExecStart=/usr/local/bin/aurora-object-store-recovery --catalog /etc/aurora-object-store/catalog.json worker --job %i
ExecStopPost=+/usr/local/sbin/aurora-object-store-verification-gate
ExecStopPost=+/bin/systemctl --no-block start aurora-object-store-recovery-upload.service
ExecStopPost=+/bin/systemctl --no-block start aurora-object-store-repair.service
ExecStopPost=+/usr/local/sbin/aurora-object-store-trigger-retention
# Epoch age limits are enforced by the worker; this is a final service bound.
TimeoutStartSec=13h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ object_store_manifest_root }} {{ object_store_recovery_root }} {{ object_store_cache_root }} {{ aurora_state_root }}/object-store-verification-gate
