[Unit]
Description=Build Aurora GWS/object-store comparison inventory
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ object_store_rclone_config }}

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
Environment=XDG_CACHE_HOME={{ object_store_cache_root }}
LoadCredential=gws-key:{{ gws_ssh_private_key }}
LoadCredential=gws-known-hosts:/home/{{ aurora_service_user }}/.ssh/known_hosts
ExecStart=/usr/local/bin/aurora-object-store-inventory
# A full audit publishes successful families as incremental checkpoints, so
# always evaluate the last atomic checkpoint even when a later family fails.
ExecStopPost=+/usr/local/sbin/aurora-object-store-verification-gate
ExecStopPost=+/usr/local/sbin/aurora-object-store-trigger-retention
TimeoutStartSec=12h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ object_store_manifest_root }} {{ object_store_cache_root }} {{ aurora_state_root }}/object-store-verification-gate
