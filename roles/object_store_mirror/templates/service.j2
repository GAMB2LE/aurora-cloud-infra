[Unit]
Description=Aurora object-store copy ({{ item.0.name }})
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ object_store_rclone_config }}

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
Environment=XDG_CACHE_HOME={{ object_store_cache_root }}
ExecStart=/usr/local/bin/aurora-object-store-copy-{{ item.0.name }}
TimeoutStartSec={{ item.0.timeout_start_sec | default('12h') }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ object_store_log_root }} {{ object_store_manifest_root }} {{ object_store_cache_root }}
