{
  "schema_version": 2,
  "remote": {{ object_store_remote | to_json }},
  "bucket": {{ object_store_bucket | to_json }},
  "rclone_config": {{ object_store_rclone_config | to_json }},
  "manifest_root": {{ object_store_manifest_root | to_json }},
  "recovery_enabled": {{ object_store_recovery_enabled | bool | to_json }},
  "recovery_deployment_id": {{ object_store_recovery_deployment_id | default('') | to_json }},
  "recovery_root": {{ object_store_recovery_root | to_json }},
  "recovery_raw_refresh_hours": {{ object_store_recovery_raw_refresh_hours | int }},
  "recovery_products_refresh_hours": {{ object_store_recovery_products_refresh_hours | int }},
  "recovery_raw_epoch_hours": {{ object_store_recovery_raw_epoch_hours | int }},
  "recovery_products_epoch_hours": {{ object_store_recovery_products_epoch_hours | int }},
  "recovery_retry_delays_seconds": {{ object_store_recovery_retry_delays_seconds | to_json }},
  "recovery_cache_max_bytes": {{ object_store_recovery_cache_max_bytes | int }},
  "recovery_free_reserve_bytes": {{ object_store_recovery_free_reserve_bytes | int }},
  "recovery_s3_page_size": {{ object_store_recovery_s3_page_size | int }},
  "recovery_s3_connect_timeout_seconds": {{ object_store_recovery_s3_connect_timeout_seconds | int }},
  "recovery_s3_read_timeout_seconds": {{ object_store_recovery_s3_read_timeout_seconds | int }},
  "gws_manifest_root": {{ gws_manifest_root | to_json }},
  "gws_user": {{ gws_username | to_json }},
  "gws_hosts": {{ gws_transfer_hosts | to_json }},
  "gws_key": {{ gws_ssh_private_key | to_json }},
  "gws_known_hosts": {{ ("/home/" ~ aurora_service_user ~ "/.ssh/known_hosts") | to_json }},
  "gws_inventory_attempts": {{ object_store_inventory_gws_attempts | int }},
  "gws_inventory_retry_delay_seconds": {{ object_store_inventory_gws_retry_delay_seconds | int }},
  "gws_settle_seconds": {{ gws_verification_gws_settle_seconds | int }},
  "list_workers": {{ object_store_inventory_workers | int }},
  "job_workers": {{ object_store_inventory_job_workers | int }},
  "shard_list_workers": {{ object_store_inventory_shard_workers | int }},
  "list_process_limit": {{ object_store_inventory_process_limit | int }},
  "list_timeout_seconds": {{ object_store_inventory_list_timeout_seconds | int }},
  "s3_list_attempts": {{ object_store_inventory_s3_list_attempts | int }},
  "s3_list_retry_delay_seconds": {{ object_store_inventory_s3_list_retry_delay_seconds | int }},
  "s3_list_retry_max_delay_seconds": {{ object_store_inventory_s3_list_retry_max_delay_seconds | int }},
  "history_keep": {{ object_store_inventory_history_keep | int }},
  "report_max_age_hours": {{ object_store_inventory_max_age_hours | int }},
  "domain_evidence_max_age_hours": {
    "raw_retention": {{ object_store_inventory_raw_evidence_max_age_hours | int }},
    "products": {{ object_store_inventory_products_evidence_max_age_hours | int }}
  },
  "jobs": {{ object_store_jobs | to_nice_json }},
  "streams": {{ aurora_archive_streams | to_nice_json }}
}
