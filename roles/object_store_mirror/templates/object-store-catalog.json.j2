{
  "schema_version": 2,
  "remote": {{ object_store_remote | to_json }},
  "bucket": {{ object_store_bucket | to_json }},
  "rclone_config": {{ object_store_rclone_config | to_json }},
  "manifest_root": {{ object_store_manifest_root | to_json }},
  "gws_manifest_root": {{ gws_manifest_root | to_json }},
  "gws_user": {{ gws_username | to_json }},
  "gws_hosts": {{ gws_transfer_hosts | to_json }},
  "gws_key": {{ (object_store_inventory_gws_runtime_dir ~ "/key") | to_json }},
  "gws_known_hosts": {{ (object_store_inventory_gws_runtime_dir ~ "/known_hosts") | to_json }},
  "gws_inventory_attempts": {{ object_store_inventory_gws_attempts | int }},
  "gws_inventory_retry_delay_seconds": {{ object_store_inventory_gws_retry_delay_seconds | int }},
  "gws_settle_seconds": {{ gws_verification_gws_settle_seconds | int }},
  "list_workers": {{ object_store_inventory_workers | int }},
  "shard_list_workers": {{ object_store_inventory_shard_workers | int }},
  "list_process_limit": {{ object_store_inventory_process_limit | int }},
  "list_timeout_seconds": {{ object_store_inventory_list_timeout_seconds | int }},
  "history_keep": {{ object_store_inventory_history_keep | int }},
  "report_max_age_hours": {{ object_store_inventory_max_age_hours | int }},
  "jobs": {{ object_store_jobs | to_nice_json }},
  "streams": {{ aurora_archive_streams | to_nice_json }}
}
