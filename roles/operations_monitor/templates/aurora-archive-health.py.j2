def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def read(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def unit(name: str) -> dict:
    completed = subprocess.run(
        [
            "systemctl",
            "show",
            name,
            "-p",
            "ActiveState",
            "-p",
            "SubState",
            "-p",
            "Result",
            "-p",
            "UnitFileState",
            "-p",
            "ExecMainExitTimestamp",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    result = {}
    for line in completed.stdout.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            result[key] = value
    result["_exists"] = bool(completed.returncode == 0 and result)
    return result


def service_healthy(state: dict) -> bool:
    if not state.get("_exists"):
        return False
    if state.get("ActiveState") == "failed":
        return False
    return state.get("Result") in {
        "success",
        "",
        "done",
        "exec-condition",
        "condition",
    }


def timer_active(state: dict) -> bool:
    return bool(state.get("_exists")) and state.get("ActiveState") == "active"


def unit_enabled(state: dict) -> bool:
    return bool(state.get("_exists")) and state.get("UnitFileState") == "enabled"


def prefix_delivery(path: Path, prefix: str) -> dict[str, int | bool]:
    """Read destination state for one raw prefix from the shared dispatcher."""
    empty = {
        "available": False,
        "tracked_files": 0,
        "dual_delivered_files": 0,
        "gws_pending_files": 0,
        "object_store_pending_files": 0,
    }
    connection = None
    try:
        connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        connection.row_factory = sqlite3.Row
        row = connection.execute(
            """
            SELECT
              COUNT(*) AS tracked,
              SUM(CASE WHEN gws_delivered = 1 AND object_delivered = 1 THEN 1 ELSE 0 END) AS delivered,
              SUM(CASE WHEN gws_delivered = 0 THEN 1 ELSE 0 END) AS gws_pending,
              SUM(CASE WHEN object_delivered = 0 THEN 1 ELSE 0 END) AS object_pending
            FROM delivery
            WHERE job = 'raw' AND relative_path LIKE ?
            """,
            (f"{prefix}%",),
        ).fetchone()
    except (OSError, sqlite3.Error):
        return empty
    finally:
        if connection is not None:
            connection.close()
    return {
        "available": True,
        "tracked_files": int(row["tracked"] or 0),
        "dual_delivered_files": int(row["delivered"] or 0),
        "gws_pending_files": int(row["gws_pending"] or 0),
        "object_store_pending_files": int(row["object_pending"] or 0),
    }


def source_sync_pairs(stream: dict) -> list[tuple[str, str, bool]]:
    stem = stream["source_sync_stem"]
    pairs = [(f"{stem}-source-sync", f"aurora-{stem}-source-sync", True)]
    pairs.extend(
        (auxiliary, f"aurora-{auxiliary}", False)
        for auxiliary in stream.get("source_sync_auxiliary_stems", [])
    )
    return pairs


def evidence_age_hours(value: object) -> float | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        timestamp = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return (
        dt.datetime.now(dt.timezone.utc) - timestamp
    ).total_seconds() / 3600


def operator_status(
    failures: list[str],
    metrics: dict[str, object],
    gate: dict,
    progress: dict,
    raw_evidence_max_age_hours: float = 8,
    product_evidence_max_age_hours: float = 36,
) -> dict[str, object]:
    """Translate the fail-closed pruning gate into actionable operations state."""
    def metric_count(key: str) -> int:
        try:
            return max(0, int(float(metrics.get(key, 0))))
        except (TypeError, ValueError):
            return 0

    def age_hours(value: object) -> float | None:
        import datetime as _dt

        if not isinstance(value, str) or not value:
            return None
        try:
            stamp = _dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return None
        return (
            _dt.datetime.now(_dt.timezone.utc) - stamp
        ).total_seconds() / 3600

    object_missing = metric_count("object_store_all_missing_count")
    object_mismatch = metric_count("object_store_all_mismatch_count")
    gws_missing = metric_count("gws_all_missing_count")
    gws_mismatch = metric_count("gws_all_mismatch_count")
    stream_gws_issues = metric_count("streams_gws_issue_count")
    measured_gap_free = all(
        float(metrics.get(key, -1)) == 0
        for key in (
            "streams_gws_issue_count",
            "object_store_all_missing_count",
            "object_store_all_mismatch_count",
            "gws_all_missing_count",
            "gws_all_mismatch_count",
        )
    )
    last_complete_clean = bool(gate.get("clean")) and bool(
        gate.get("stable_parity")
    )
    latest_complete_clean = bool(gate.get("clean"))
    domains = gate.get("domains")
    if not isinstance(domains, dict):
        domains = {}
    raw_gate = domains.get("raw_retention")
    if not isinstance(raw_gate, dict):
        raw_gate = gate
    raw_ready = bool(
        gate.get("raw_retention_ready", raw_gate.get("stable_parity", False))
    )
    raw_clean = bool(raw_gate.get("clean"))
    raw_evidence_at = raw_gate.get("evidence_floor_generated_at") or raw_gate.get(
        "last_clean_at"
    ) or (
        gate.get("last_generated_at") if raw_clean else None
    )
    raw_evidence_age = age_hours(raw_evidence_at)
    raw_ready = bool(
        raw_ready
        and raw_evidence_age is not None
        and raw_evidence_age <= raw_evidence_max_age_hours
    )
    product_gate = domains.get("products")
    if not isinstance(product_gate, dict):
        product_gate = gate
    product_clean = bool(product_gate.get("clean"))
    product_evidence_at = product_gate.get(
        "evidence_floor_generated_at"
    ) or product_gate.get("last_clean_at") or (
        gate.get("last_generated_at") if product_clean else None
    )
    product_evidence_age = age_hours(product_evidence_at)
    product_current = bool(
        product_clean
        and product_evidence_age is not None
        and product_evidence_age <= product_evidence_max_age_hours
    )
    delivery_oldest = float(
        metrics.get("archive_delivery_oldest_pending_age_minutes", 0) or 0
    )
    delivery_success_age = metrics.get(
        "archive_delivery_last_success_age_minutes"
    )
    try:
        delivery_success_age = float(delivery_success_age)
    except (TypeError, ValueError):
        delivery_success_age = None
    delivery_red = delivery_oldest >= 120 or (
        delivery_success_age is not None and delivery_success_age >= 120
    )
    delivery_amber = delivery_oldest >= 30 or (
        delivery_success_age is not None and delivery_success_age >= 30
    )
    verification_only = bool(failures) and all(
        item.startswith("object_store_evidence_stale_hours=")
        or item.startswith("object_store_inventory_progress_stale_minutes=")
        or item
        == "archive_service_unhealthy=aurora-object-store-inventory.service"
        for item in failures
    )
    completed = progress.get("completed_jobs")
    if not isinstance(completed, list):
        completed = []
    total = int(progress.get("total_jobs") or 0)
    current_jobs = progress.get("current_jobs")
    if not isinstance(current_jobs, list):
        current_jobs = []
    current = ", ".join(str(value).replace("-", " ") for value in current_jobs[:3])
    if not current:
        current = str(progress.get("current_job") or "archive families").replace("-", " ")
    phase = str(progress.get("phase") or "verification").replace("_", " ")

    pruning_paused = not raw_ready
    if not measured_gap_free:
        details: list[str] = []
        if object_missing:
            noun = "file" if object_missing == 1 else "files"
            details.append(
                f"The last complete strict audit found {object_missing:,} settled {noun} "
                "missing from JASMIN object storage."
            )
        if object_mismatch:
            noun = "file" if object_mismatch == 1 else "files"
            details.append(
                f"It also found {object_mismatch:,} object-store {noun} with a size mismatch."
            )
        if gws_missing or gws_mismatch or stream_gws_issues:
            gws_parts = []
            if gws_missing:
                gws_parts.append(f"{gws_missing:,} missing")
            if gws_mismatch:
                gws_parts.append(f"{gws_mismatch:,} size mismatched")
            if stream_gws_issues:
                gws_parts.append(f"{stream_gws_issues:,} retention-stream issues")
            details.append(f"GWS verification reports {', '.join(gws_parts)}.")
        elif object_missing or object_mismatch:
            details.append("The retention-age GWS copy is complete.")
        if progress.get("state") in {"running", "publishing"}:
            details.append("A strict recheck is running now.")
        else:
            details.append("Exact-path repair and a strict recheck are required.")
        if pruning_paused:
            details.append("Affected edge pruning remains paused until raw archives verify cleanly.")
        else:
            details.append("Raw retention evidence remains independently clean.")
        return {
            "level": "red",
            "title": "Archive copies are incomplete",
            "detail": " ".join(details),
            "pruning_paused": pruning_paused,
        }
    if delivery_red:
        return {
            "level": "red",
            "title": "Archive delivery is stalled",
            "detail": (
                f"The oldest dual-destination delivery has waited {delivery_oldest:.0f} minutes. "
                "Copy writers need attention; pruning is paused for uncertified files."
            ),
            "pruning_paused": True,
        }
    if (
        raw_clean
        and raw_evidence_age is not None
        and raw_evidence_age <= raw_evidence_max_age_hours
        and product_evidence_age is not None
        and product_evidence_age > product_evidence_max_age_hours
    ):
        retention_detail = (
            "Raw retention evidence remains independently current."
            if raw_ready
            else "Raw evidence is current, but its second retention confirmation is pending."
        )
        return {
            "level": "amber",
            "title": "Product archive verification is overdue",
            "detail": (
                f"The oldest product-family evidence is {product_evidence_age:.1f} "
                f"hours old, beyond its {product_evidence_max_age_hours:g}-hour limit. "
                f"{retention_detail}"
            ),
            "pruning_paused": pruning_paused,
        }
    if (
        raw_clean
        and raw_evidence_age is not None
        and raw_evidence_age <= raw_evidence_max_age_hours
        and product_current
        and not delivery_amber
    ):
        if progress.get("state") in {"running", "publishing"}:
            verification_detail = " A routine strict audit is running in the background."
        elif progress.get("state") == "failed":
            verification_detail = " The latest listing attempt failed, but certified evidence remains current."
        elif not raw_ready:
            verification_detail = " A second retention confirmation is pending."
        else:
            verification_detail = ""
        return {
            "level": "green",
            "title": "Archive copies are healthy",
            "detail": (
                "Newest files are being delivered to GWS and object storage; "
                "the last certified raw parity check is clean."
                + verification_detail
            ),
            "pruning_paused": pruning_paused,
        }
    if raw_evidence_age is not None and raw_evidence_age > 24:
        completed_count = len(completed)
        completion = (
            f" after {completed_count} of {total} archive families completed"
            if completed_count and total
            else ""
        )
        if progress.get("state") == "failed":
            error = str(progress.get("error") or "").lower()
            if "permission denied" in error and "xfer-vm" in error:
                reason = (
                    "The latest strict audit could not finish because JASMIN "
                    f"rejected the verifier login{completion}."
                )
            elif "504" in error or "timed out" in error or "timeout" in error:
                reason = (
                    "The latest strict audit could not finish because a JASMIN "
                    f"archive listing timed out{completion}."
                )
            else:
                reason = f"The latest strict audit did not finish{completion}."
            title = "Archive verification is delayed"
        else:
            reason = (
                f"The last certified raw parity evidence is {raw_evidence_age:.1f} hours old."
            )
            title = "Archive verification is overdue"
        return {
            "level": "amber",
            "title": title,
            "detail": (
                f"{reason} Live delivery is continuing and no settled archive gap is "
                "currently measured. Pruning stays paused until a fresh raw "
                "verification succeeds."
            ),
            "pruning_paused": True,
        }
    if delivery_amber or (
        raw_evidence_age is not None
        and raw_evidence_age > raw_evidence_max_age_hours
    ):
        reasons = []
        if delivery_amber:
            reasons.append(f"oldest pending delivery is {delivery_oldest:.0f} minutes")
        if (
            raw_evidence_age is not None
            and raw_evidence_age > raw_evidence_max_age_hours
        ):
            reasons.append(f"certified raw evidence is {raw_evidence_age:.1f} hours old")
        return {
            "level": "amber",
            "title": "Archive verification needs attention",
            "detail": "; ".join(reasons).capitalize() + ". No settled copy gap is currently proven.",
            "pruning_paused": pruning_paused,
        }
    if measured_gap_free and last_complete_clean and verification_only:
        if progress.get("state") in {"running", "publishing"}:
            count = f"{len(completed)} of {total}" if total else str(len(completed))
            return {
                "level": "amber",
                "title": "Archive verification is running",
                "detail": (
                    f"Strict audit {count} families complete; checking {current} ({phase}). "
                    "Last complete verification was clean. New pruning is paused until this audit finishes."
                ),
                "pruning_paused": True,
            }
        if progress.get("state") == "failed":
            error = str(progress.get("error") or "object-store listing failed")
            normalized_error = error.lower().replace("-", "_").replace(" ", "_")
            target = (
                "ASFS fast-gas products"
                if "asfs_fast_gas" in normalized_error
                else "archive products"
            )
            return {
                "level": "amber",
                "title": "Archive verification failed",
                "detail": (
                    f"JASMIN object-store listing timed out for {target}. "
                    "Last complete verification was clean. New pruning is paused until verification succeeds."
                ),
                "pruning_paused": True,
            }
        return {
            "level": "amber",
            "title": "Archive verification is delayed",
            "detail": "Last complete verification was clean, but fresh strict evidence is overdue. New pruning is paused.",
            "pruning_paused": True,
        }
    return {
        "level": "red",
        "title": "Archive service or verification needs attention",
        "detail": (
            "Archive verification is not currently sufficient to prove both copies are complete. "
            "Delivery continues where possible, but edge pruning is paused. Review archive service health."
        ),
        "pruning_paused": True,
    }


def main() -> int:
    gws = read(GWS)
    object_report = read(OBJECT)
    inventory_progress = read(INVENTORY_PROGRESS)
    dispatch = read(DISPATCH)
    menapia_status = read(MENAPIA_FLIGHT_STATUS)
    menapia_delivery = prefix_delivery(
        DISPATCH_DATABASE,
        "menapia/drone-uploads/",
    )
    gate = read(GATE)
    metrics: dict[str, object] = {}
    failures: list[str] = []
    gws_age = evidence_age_hours(gws.get("generated_at"))
    object_age = evidence_age_hours(object_report.get("generated_at"))
    if gws_age is None:
        failures.append("gws_evidence_missing")
    elif gws_age > RAW_EVIDENCE_MAX_AGE_HOURS:
        failures.append(f"gws_evidence_stale_hours={gws_age:.2f}")
    if object_age is None:
        failures.append("object_store_evidence_missing")
    elif object_age > OBJECT_REPORT_MAX_AGE_HOURS:
        failures.append(f"object_store_evidence_stale_hours={object_age:.2f}")
    issues = 0
    prune_ready = 0
    retention_streams = []
    for stream in STREAMS:
        name = stream["name"]
        state = gws.get("streams", {}).get(name, {})
        prefix = PREFIX.get(name, name)
        missing = int(state.get("gws_missing_count") or 0)
        mismatch = int(state.get("gws_mismatch_count") or 0)
        retention_missing = int(state.get("retention_gws_missing_count") or 0)
        retention_mismatch = int(state.get("retention_gws_mismatch_count") or 0)
        count = int(state.get("source_count") or 0)
        gws_count = int(state.get("gws_count") or 0)
        coverage = 100.0 if count == 0 else min(100.0, gws_count * 100.0 / count)
        metrics[f"{prefix}_gws_missing_count"] = missing
        metrics[f"{prefix}_gws_mismatch_count"] = mismatch
        metrics[f"{prefix}_retention_gws_missing_count"] = retention_missing
        metrics[f"{prefix}_retention_gws_mismatch_count"] = retention_mismatch
        metrics[f"{prefix}_gws_coverage_pct"] = coverage
        metrics[f"{prefix}_prune_ready_state"] = int(
            bool(state.get("prune_ready")) and bool(stream.get("prune_enabled"))
        )
        retention_streams.append(
            {
                "id": name,
                "enabled": bool(stream.get("prune_enabled")),
                "ready": bool(metrics[f"{prefix}_prune_ready_state"]),
                "gws_missing": retention_missing,
                "gws_mismatch": retention_mismatch,
            }
        )
        # Fresh in-flight gaps remain observable above but do not make
        # seven-day retention unsafe.  The retention verifier supplies the
        # explicitly age-bounded counters used for the health gate.
        issues += retention_missing + retention_mismatch
        prune_ready += int(bool(metrics[f"{prefix}_prune_ready_state"]))

    object_missing = 0
    object_mismatch = 0
    gws_job_missing = 0
    gws_job_mismatch = 0
    raw_missing = 0
    raw_mismatch = 0
    for job_name, job in object_report.get("jobs", {}).items():
        comparison = job.get("source_vs_s3") or {}
        missing = len(comparison.get("missing_from_right", []))
        mismatch = len(comparison.get("size_mismatch", [])) + len(
            comparison.get("checksum_mismatch", [])
        )
        metric_name = job_name.replace("-", "_")
        pending = job.get("pending_upload") or {}
        pending_missing = len(pending.get("missing_from_right", []))
        metrics[f"object_store_{metric_name}_missing_count"] = missing
        metrics[f"object_store_{metric_name}_mismatch_count"] = mismatch
        metrics[f"object_store_{metric_name}_pending_upload_count"] = pending_missing
        object_missing += missing
        object_mismatch += mismatch
        gws_comparison = job.get("source_vs_gws") or {}
        gws_missing = len(gws_comparison.get("missing_from_right", []))
        gws_mismatch = len(gws_comparison.get("size_mismatch", [])) + len(
            gws_comparison.get("checksum_mismatch", [])
        )
        metrics[f"gws_{metric_name}_missing_count"] = gws_missing
        metrics[f"gws_{metric_name}_mismatch_count"] = gws_mismatch
        # The raw path is covered by the per-stream, age-bounded verifier
        # above. Keep its all-age value as telemetry, but do not turn normal
        # live-transfer lag into an archive-retention failure.
        if job_name != "raw":
            gws_job_missing += gws_missing
            gws_job_mismatch += gws_mismatch
        if job_name == "raw":
            raw_missing = missing
            raw_mismatch = mismatch
    metrics.update(
        {
            "streams_gws_issue_count": issues,
            "streams_prune_ready_count": prune_ready,
            "streams_target_count": len(STREAMS),
            "object_store_raw_missing_count": raw_missing,
            "object_store_raw_mismatch_count": raw_mismatch,
            "object_store_all_missing_count": object_missing,
            "object_store_all_mismatch_count": object_mismatch,
            "gws_all_missing_count": gws_job_missing,
            "gws_all_mismatch_count": gws_job_mismatch,
            "object_store_clean_streak": int(gate.get("clean_streak", 0)),
            "object_store_stable_parity_state": int(
                bool(gate.get("stable_parity"))
            ),
            "object_store_writers_independent_state": int(
                gate.get("writers_policy") == "independent"
            ),
        }
    )
    services = {}
    archive_units = [
        *ARCHIVE_SERVICES,
        *ARCHIVE_TRIGGERS,
        "aurora-ass-retention.timer",
    ]
    incremental_units = []
    if inventory_progress.get("verification_mode") == "incremental":
        verified_jobs = inventory_progress.get("verified_jobs")
        if isinstance(verified_jobs, list):
            incremental_units = [
                f"aurora-object-store-inventory-incremental@{job}.service"
                for job in verified_jobs
            ]
    source_sync_units = []
    for stream in STREAMS:
        for _stem, unit_stem, _primary in source_sync_pairs(stream):
            source_sync_units.extend(
                [f"{unit_stem}.timer", f"{unit_stem}.service"]
            )
    if MENAPIA_FLIGHT_ENABLED:
        source_sync_units.extend(
            [
                "aurora-menapia-flight-source-sync.timer",
                "aurora-menapia-flight-source-sync.service",
            ]
        )
    for name in [*archive_units, *incremental_units, *source_sync_units]:
        services[name] = unit(name)
    metrics["mirror_verify_service_healthy_state"] = int(
        services["aurora-mirror-verify.service"].get("Result") == "success"
    )
    for service_name in GWS_WRITERS:
        metric_name = service_name.removeprefix("aurora-").removesuffix(
            ".service"
        ).replace("-", "_")
        state = services[service_name]
        healthy = state.get("Result") == "success" and state.get(
            "ActiveState"
        ) != "failed"
        metrics[f"{metric_name}_healthy_state"] = int(healthy)
        if not healthy:
            failures.append(f"gws_writer_unhealthy={service_name}")
    metrics["ass_retention_enabled_state"] = int(
        services["aurora-ass-retention.timer"].get("UnitFileState") == "enabled"
    )
    inventory_units = [
        "aurora-object-store-inventory.service",
        *incremental_units,
    ]
    metrics["object_store_inventory_running_state"] = int(
        any(
            services[name].get("ActiveState") == "activating"
            for name in inventory_units
        )
    )
    progress_age_hours = evidence_age_hours(inventory_progress.get("updated_at"))
    progress_age_minutes = (
        progress_age_hours * 60 if progress_age_hours is not None else None
    )
    metrics["object_store_inventory_progress_age_minutes"] = progress_age_minutes
    progress_recent = (
        progress_age_minutes is not None and progress_age_minutes <= 5
    )
    metrics["object_store_inventory_progress_recent_state"] = int(
        progress_recent
    )
    dispatch_queue = dispatch.get("queue")
    if not isinstance(dispatch_queue, dict):
        dispatch_queue = {}
    dispatch_run = dispatch.get("last_run")
    if not isinstance(dispatch_run, dict):
        dispatch_run = {}
    dispatch_success_age = evidence_age_hours(dispatch.get("last_success_at"))
    metrics.update(
        {
            "archive_delivery_pending_count": int(dispatch_queue.get("pending_files") or 0),
            "archive_delivery_pending_bytes": int(dispatch_queue.get("pending_bytes") or 0),
            "archive_delivery_gws_pending_count": int(dispatch_queue.get("gws_pending_files") or 0),
            "archive_delivery_object_store_pending_count": int(dispatch_queue.get("object_store_pending_files") or 0),
            "archive_delivery_oldest_pending_age_minutes": float(
                dispatch_queue.get("oldest_pending_age_minutes") or 0
            ),
            "archive_delivery_last_success_age_minutes": (
                dispatch_success_age * 60 if dispatch_success_age is not None else None
            ),
            "archive_delivery_last_run_success_state": int(
                dispatch_run.get("state") in {"complete", "idle"}
            ),
        }
    )
    if (
        metrics["object_store_inventory_running_state"]
        and not progress_recent
    ):
        value = (
            "missing"
            if progress_age_minutes is None
            else f"{progress_age_minutes:.2f}"
        )
        failures.append(
            f"object_store_inventory_progress_stale_minutes={value}"
        )
    for service_name in ARCHIVE_SERVICES:
        state = services[service_name]
        slug = service_name.removeprefix("aurora-").removesuffix(
            ".service"
        ).replace("-", "_")
        healthy = service_healthy(state)
        metrics[f"{slug}_service_healthy_state"] = int(healthy)
        if not healthy:
            failures.append(f"archive_service_unhealthy={service_name}")
    for trigger_name in ARCHIVE_TRIGGERS:
        state = services[trigger_name]
        slug = trigger_name.removeprefix("aurora-").replace(".", "_").replace(
            "-", "_"
        )
        active = timer_active(state)
        enabled = unit_enabled(state)
        metrics[f"{slug}_active_state"] = int(active)
        metrics[f"{slug}_enabled_state"] = int(enabled)
        if not active:
            failures.append(f"archive_trigger_inactive={trigger_name}")
        if not enabled:
            failures.append(f"archive_trigger_disabled={trigger_name}")
    failed_source_sync = 0
    source_sync_enabled = 0
    for stream in STREAMS:
        prefix = PREFIX.get(stream["name"], stream["name"])
        for stem, unit_stem, primary in source_sync_pairs(stream):
            timer_name = f"{unit_stem}.timer"
            service_name = f"{unit_stem}.service"
            timer_state = services[timer_name]
            service_state = services[service_name]
            active = timer_active(timer_state)
            enabled = unit_enabled(timer_state)
            healthy = service_healthy(service_state)
            metric_stem = stem.replace("-", "_")
            metrics[f"{metric_stem}_timer_active_state"] = int(active)
            metrics[f"{metric_stem}_timer_enabled_state"] = int(enabled)
            metrics[f"{metric_stem}_service_healthy_state"] = int(healthy)
            if primary:
                metrics[f"{prefix}_source_sync_service_healthy_state"] = int(
                    healthy
                )
            failed_source_sync += int(not active) + int(not healthy)
            source_sync_enabled += int(enabled)
            if not active:
                failures.append(f"source_sync_timer_inactive={timer_name}")
            if not healthy:
                failures.append(f"source_sync_service_unhealthy={service_name}")
    if MENAPIA_FLIGHT_ENABLED:
        timer_name = "aurora-menapia-flight-source-sync.timer"
        service_name = "aurora-menapia-flight-source-sync.service"
        timer_state = services[timer_name]
        service_state = services[service_name]
        timer_active_state = timer_active(timer_state)
        timer_enabled_state = unit_enabled(timer_state)
        unit_healthy = service_healthy(service_state)
        source_state = str(menapia_status.get("state") or "missing")
        authentication_failure = bool(
            menapia_status.get("authentication_failure")
        )
        source_healthy = bool(
            unit_healthy
            and source_state in {"success", "success_with_backlog", "inventory_only"}
            and not authentication_failure
        )
        credential = menapia_status.get("credential")
        if not isinstance(credential, dict):
            credential = {}
        last_success_age = evidence_age_hours(
            menapia_status.get("last_success_at")
        )
        latest_flight = menapia_status.get("latest_source_flight")
        if not isinstance(latest_flight, dict):
            latest_flight = {}
        metrics.update(
            {
                "menapia_flight_commissioned_state": int(
                    MENAPIA_FLIGHT_TIMER_EXPECTED
                ),
                "menapia_flight_timer_active_state": int(timer_active_state),
                "menapia_flight_timer_enabled_state": int(timer_enabled_state),
                "menapia_flight_source_sync_service_healthy_state": int(
                    source_healthy
                ),
                "menapia_flight_authentication_failure_state": int(
                    authentication_failure
                ),
                "menapia_flight_last_success_age_minutes": (
                    last_success_age * 60
                    if last_success_age is not None
                    else None
                ),
                "menapia_flight_upstream_objects_examined": int(
                    menapia_status.get("upstream_objects_examined") or 0
                ),
                "menapia_flight_new_objects_ingested": int(
                    menapia_status.get("new_objects_ingested") or 0
                ),
                "menapia_flight_bytes_transferred": int(
                    menapia_status.get("bytes_transferred") or 0
                ),
                "menapia_flight_failure_count": int(
                    menapia_status.get("failure_count") or 0
                ),
                "menapia_flight_unclassified_object_count": int(
                    menapia_status.get("unclassified_objects") or 0
                ),
                "menapia_flight_upstream_revision_count": int(
                    menapia_status.get("upstream_revisions_ingested") or 0
                ),
                "menapia_flight_credential_days_remaining": credential.get(
                    "days_remaining"
                ),
                "menapia_flight_latest_source_date": latest_flight.get("date"),
                "menapia_flight_latest_source_flight": latest_flight.get(
                    "flight"
                ),
                "menapia_flight_archive_tracked_files": int(
                    menapia_delivery["tracked_files"]
                ),
                "menapia_flight_archive_dual_delivered_files": int(
                    menapia_delivery["dual_delivered_files"]
                ),
                "menapia_flight_gws_pending_files": int(
                    menapia_delivery["gws_pending_files"]
                ),
                "menapia_flight_object_store_pending_files": int(
                    menapia_delivery["object_store_pending_files"]
                ),
            }
        )
        if MENAPIA_FLIGHT_TIMER_EXPECTED:
            failed_source_sync += int(not timer_active_state) + int(
                not source_healthy
            )
            source_sync_enabled += int(timer_enabled_state)
            if not timer_active_state:
                failures.append(f"source_sync_timer_inactive={timer_name}")
            if not source_healthy:
                failures.append(
                    f"source_sync_service_unhealthy={service_name}"
                )
            if authentication_failure:
                failures.append("menapia_flight_authentication_failure=true")
    metrics["failed_source_sync_unit_count"] = failed_source_sync
    metrics["source_sync_enabled_count"] = source_sync_enabled
    if issues:
        failures.append(f"gws_issues={issues}")
    if object_missing:
        failures.append(f"object_store_all_missing={object_missing}")
    if object_mismatch:
        failures.append(f"object_store_all_mismatch={object_mismatch}")
    if gws_job_missing:
        failures.append(f"gws_all_missing={gws_job_missing}")
    if gws_job_mismatch:
        failures.append(f"gws_all_mismatch={gws_job_mismatch}")
    if not gate.get("stable_parity", False):
        failures.append("object_store_stable_parity=false")
    presentation = operator_status(
        failures,
        metrics,
        gate,
        inventory_progress,
        RAW_EVIDENCE_MAX_AGE_HOURS,
        OBJECT_REPORT_MAX_AGE_HOURS,
    )
    metrics["archive_pruning_paused_state"] = int(
        bool(presentation["pruning_paused"])
    )
    domains = gate.get("domains")
    if not isinstance(domains, dict):
        domains = {}
    raw_domain = domains.get("raw_retention")
    if not isinstance(raw_domain, dict):
        raw_domain = gate
    product_domain = domains.get("products")
    if not isinstance(product_domain, dict):
        product_domain = gate
    oldest_pending = float(
        metrics.get("archive_delivery_oldest_pending_age_minutes", 0) or 0
    )
    last_delivery_success = metrics.get(
        "archive_delivery_last_success_age_minutes"
    )
    delivery_level = (
        "red"
        if oldest_pending >= 120
        or (
            isinstance(last_delivery_success, (int, float))
            and last_delivery_success >= 120
        )
        else "amber"
        if oldest_pending >= 30
        or (
            isinstance(last_delivery_success, (int, float))
            and last_delivery_success >= 30
        )
        else "green"
    )
    verification_state = str(inventory_progress.get("state") or "unknown")
    payload = {
        "schema_version": "health-v2",
        "contract_version": 2,
        "generated_at": now(),
        "overall_level": presentation["level"],
        "failures": failures,
        "operator_status": presentation,
        "metrics": metrics,
        "services": services,
        "source_ingest": {
            "menapia": {
                **menapia_status,
                "enabled": MENAPIA_FLIGHT_ENABLED,
                "commissioned": MENAPIA_FLIGHT_TIMER_EXPECTED,
                "archive_delivery": menapia_delivery,
            }
        },
        "delivery": {
            "level": delivery_level,
            "mode": "newest-first",
            "pending_files": metrics.get("archive_delivery_pending_count", 0),
            "pending_bytes": metrics.get("archive_delivery_pending_bytes", 0),
            "gws_pending_files": metrics.get(
                "archive_delivery_gws_pending_count", 0
            ),
            "object_store_pending_files": metrics.get(
                "archive_delivery_object_store_pending_count", 0
            ),
            "oldest_pending_age_minutes": oldest_pending,
            "last_success_age_minutes": last_delivery_success,
        },
        "durability": {
            "raw_retention": raw_domain,
            "products": product_domain,
            "gws_missing": metrics.get("gws_all_missing_count", 0),
            "gws_mismatch": metrics.get("gws_all_mismatch_count", 0),
            "object_store_missing": metrics.get(
                "object_store_all_missing_count", 0
            ),
            "object_store_mismatch": metrics.get(
                "object_store_all_mismatch_count", 0
            ),
        },
        "verification": {
            "state": verification_state,
            "mode": inventory_progress.get("verification_mode"),
            "completed_jobs": inventory_progress.get("completed_jobs", []),
            "total_jobs": int(inventory_progress.get("total_jobs") or 0),
            "current_jobs": inventory_progress.get("current_jobs") or [],
            "phase": inventory_progress.get("phase"),
            "updated_at": inventory_progress.get("updated_at"),
            "last_complete_at": gate.get("last_generated_at"),
            "last_certified_raw_at": raw_domain.get("last_clean_at"),
            "error": inventory_progress.get("error"),
        },
        "retention": {
            "ready": bool(gate.get("raw_retention_ready", False))
            and not bool(presentation["pruning_paused"]),
            "paused": bool(presentation["pruning_paused"]),
            "reason": (
                "raw archive evidence is not yet stably clean"
                if presentation["pruning_paused"]
                else ""
            ),
            "retention_days": 7,
            "streams": retention_streams,
        },
        "evidence": {
            "gws_generated_at": gws.get("generated_at"),
            "object_store_generated_at": object_report.get("generated_at"),
            "object_store_gate": gate,
            "object_store_inventory_progress": inventory_progress,
            "archive_dispatch": dispatch,
        },
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    temporary.replace(OUTPUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
