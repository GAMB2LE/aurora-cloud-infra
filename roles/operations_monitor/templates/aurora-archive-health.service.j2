[Unit]
Description=Publish Aurora archive health contract
After=network-online.target

[Service]
Type=oneshot
User={{ aurora_service_user }}
Group={{ aurora_service_group }}
ExecStart=/usr/local/bin/aurora-archive-health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite needs to create or lock its journal beside the dispatcher database even
# when the connection itself is opened read-only.  Keep the writable exception
# limited to the dispatcher's internal state directory.
ReadWritePaths={{ archive_monitor_output_root }} {{ archive_dispatch_state_root }}
