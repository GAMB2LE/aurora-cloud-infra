#!/usr/bin/env bash
set -euo pipefail

# The live lane has an independent checkpoint.  Historical recovery is owned
# by aurora-radar-backfill, so a multi-terabyte LV0 transfer cannot delay new
# radar files.
source_user={{ radar_source_user | quote }}
source_host={{ radar_source_host | quote }}
source_port={{ radar_source_port | int }}
source_path={{ radar_source_path | quote }}
source_pattern={{ radar_live_source_pattern | quote }}
destination={{ radar_source_destination | quote }}
state_file={{ radar_source_state_file | quote }}
bootstrap_lookback_seconds={{ radar_source_bootstrap_lookback_seconds | int }}
overlap_seconds={{ radar_source_overlap_seconds | int }}
mtime_grace_seconds={{ radar_source_mtime_grace_seconds | int }}
required_mount={{ radar_source_required_mount | quote }}
reserve_bytes={{ radar_backfill_free_reserve_bytes | int }}
max_batch_bytes={{ radar_source_max_batch_bytes | int }}
transfer_guard=/usr/local/lib/aurora-radar-transfer-guard.py
known_hosts=/home/{{ aurora_service_user }}/.ssh/known_hosts
lock_file={{ aurora_state_root | quote }}/radar-live-sync.lock

"$transfer_guard" capacity --root "$destination" --required-mount "$required_mount" \
  --workers 1 --max-file-bytes 0 --reserve-bytes "$reserve_bytes"
mkdir -p "$(dirname "$state_file")" "$(dirname "$known_hosts")"
exec 9>"$lock_file"
flock -n 9 || exit 0

now_epoch="$(date +%s)"
if [[ -f "$state_file" ]] && [[ "$(cat "$state_file")" =~ ^[0-9]+$ ]]; then
  last_epoch="$(cat "$state_file")"
else
  last_epoch=$(( now_epoch - bootstrap_lookback_seconds ))
fi
scan_epoch=$(( last_epoch - overlap_seconds ))
safe_now_epoch=$(( now_epoch - mtime_grace_seconds ))
(( scan_epoch < 0 )) && scan_epoch=0
recovery=false
if (( $# )); then
  if [[ $# != 3 || "$1" != --recover-window || ! "$2" =~ ^[0-9]+$ || ! "$3" =~ ^[0-9]+$ ]]; then
    echo 'Usage: aurora-radar-sync [--recover-window START_EPOCH END_EPOCH]' >&2
    exit 64
  fi
  if (( $2 >= $3 || $3 > safe_now_epoch )); then
    echo 'Recovery needs a closed, ordered time window older than the source grace period.' >&2
    exit 64
  fi
  scan_epoch="$2"
  safe_now_epoch="$3"
  recovery=true
fi

ssh_opts=(
  -p "$source_port" -o BatchMode=yes -o ConnectTimeout=15
  -o IdentitiesOnly=yes -o IdentityFile=none -o PubkeyAuthentication=no
  -o ServerAliveInterval=15 -o ServerAliveCountMax=4
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$known_hosts"
)
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
files_from="$workdir/files"
# ssh joins arguments into a remote shell command. Quote the wildcard here;
# an unquoted '*' expands in the remote home directory and silently finds nothing.
remote_source_path="$(printf '%q' "$source_path")"
remote_pattern="$(printf '%q' "$source_pattern")"
ssh "${ssh_opts[@]}" "${source_user}@${source_host}" \
  "cd $remote_source_path && find . -type f -name $remote_pattern -newermt '@$scan_epoch' ! -newermt '@$safe_now_epoch' -printf '%s\\t%P\\0'" > "$workdir/records"

selected_bytes="$(python3 - "$workdir" "$max_batch_bytes" <<'PY'
import os
import sys
from pathlib import Path

workdir, maximum = Path(sys.argv[1]), int(sys.argv[2])
files, total = [], 0
for record in (workdir / 'records').read_bytes().split(b'\0'):
    if not record:
        continue
    raw_size, relative = record.split(b'\t', 1)
    path = Path(os.fsdecode(relative))
    if path.is_absolute() or '..' in path.parts or int(raw_size) < 0:
        raise SystemExit('Invalid radar source record')
    total += int(raw_size)
    files.append(relative)
if total > maximum:
    raise SystemExit(f'Radar live batch hold: selected={total}, maximum={maximum}; use a bounded recovery window')
(workdir / 'files').write_bytes(b''.join(row + b'\0' for row in files))
print(total)
PY
)"
"$transfer_guard" capacity --root "$destination" --required-mount "$required_mount" \
  --workers 1 --max-file-bytes "$selected_bytes" --reserve-bytes "$reserve_bytes"
echo "Radar live selection: $selected_bytes bytes; recovery=$recovery."

if [[ -s "$files_from" ]]; then
  # The live lane carries LV1 NetCDF for freshness. The independent bounded
  # backfill retains responsibility for every native class and its archive debt.
  rsync -az --partial --timeout=120 --from0 --files-from="$files_from" \
    -e "ssh ${ssh_opts[*]}" "${source_user}@${source_host}:${source_path%/}/" "${destination%/}/"
  if [[ -x /usr/local/bin/aurora-archive-dispatch ]]; then
    /usr/local/bin/aurora-archive-dispatch enqueue --job raw --base "$destination" --files-from "$files_from" --null
  fi
fi
if [[ "$recovery" == false ]]; then
  echo "$now_epoch" > "$state_file"
  echo "Radar live checkpoint advanced to $now_epoch."
else
  echo 'Radar recovery window complete; normal live checkpoint unchanged.'
fi
