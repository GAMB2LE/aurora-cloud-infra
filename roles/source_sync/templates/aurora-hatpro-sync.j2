#!/usr/bin/env bash
set -euo pipefail

# Discovery changes only: the same rsync copier and shared archive dispatcher
# remain in use. Neither the live timer nor the backfill timer is changed.
exec /usr/bin/python3 -B /usr/local/lib/aurora-hatpro-discovery.py \
  --source-user {{ hatpro_source_user | quote }} \
  --source-host {{ hatpro_source_host | quote }} \
  --source-port {{ hatpro_source_port | int }} \
  --source-path {{ hatpro_source_path | quote }} \
  --source-pattern {{ hatpro_source_pattern | quote }} \
  --destination {{ hatpro_source_destination | quote }} \
  --state-file {{ hatpro_source_state_file | quote }} \
  --source-auth {{ hatpro_source_auth | default('tailscale') | quote }} \
  --ssh-key {{ hatpro_source_ssh_key_path | quote }} \
{% if hatpro_source_start_fresh | bool %}
  --start-fresh \
{% endif %}
  --known-hosts /home/{{ aurora_service_user }}/.ssh/known_hosts
