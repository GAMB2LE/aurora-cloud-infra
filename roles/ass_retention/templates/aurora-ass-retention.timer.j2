[Unit]
Description=Schedule verified ASS seven-day retention

[Timer]
OnCalendar={{ ass_retention_schedule }}
{% if ass_retention_catchup_once is defined %}
OnCalendar={{ ass_retention_catchup_once }}
{% endif %}
Persistent=true
RandomizedDelaySec={{ '0' if ass_retention_catchup_once is defined else '20min' }}
Unit={{ 'aurora-ass-retention-window.service' if (ass_retention_window_enabled | default(false) | bool) else 'aurora-ass-retention.service' }}

[Install]
WantedBy=timers.target
