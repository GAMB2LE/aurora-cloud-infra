# Readers use the checked JASMIN replicas for observations. The existing
# development forecast bundle and its producer inputs remain separate.
AURORA_DATA_MODE=live-mirror
AURORA_OPERATIONAL_MIRROR=false
AURORA_POWER_FORECAST_PUBLICATION_ACTIVE=false
AURORA_POWER_FORECAST_ONLY_PUBLICATION_ACTIVE=true
POWER_DISPLAY_SUMMARY_ZARR_PATH=/data/aurora/products/power/power_display_summary.zarr
POWER_DISPLAY_ENERGY_ZARR_PATH=/data/aurora/products/power/power_display_energy.zarr
POWER_CURRENT_DISPLAY_ZARR_PATH=/data/aurora/products/power/power_current_display.zarr
POWER_DISPLAY_MANIFEST_PATH=/data/aurora/products/power/power_display_manifest.json
BLESENSORS_ZARR_PATH=/data/aurora/products/blesensors/blesensors.zarr
BLESENSORS_SOURCE_LABEL=SwitchBot via ASS - JASMIN mirror
AURORA_INTERACTIVE_PREWARM_DIR=/data/aurora/products/dashboard/prewarm
OPS_MONITOR_LATEST_SNAPSHOT=/project/aurora/raw/ops_monitor/latest.json
OPS_MONITOR_SNAPSHOT_PATH=/project/aurora/raw/ops_monitor/latest.json
OPS_MONITOR_LATEST_HEALTH=/data/aurora/products/ops_monitor/health/latest_health.json
OPS_MONITOR_ALERT_STATE=/data/aurora/products/ops_monitor/alerts/state.json
