[Service]
WorkingDirectory={{ aurora_presentation_app_dir }}
EnvironmentFile=/etc/aurora-presentation.env
{% if aurora_presentation_canonical_observations | default(false) %}
EnvironmentFile=/etc/aurora-canonical-observations.env
{% endif %}
ExecStart=
ExecStart={{ aurora_presentation_venv }}/bin/uvicorn mobile_api:app --host {{ aurora_mobile_api_host }} --port {{ aurora_mobile_api_port }} --workers {{ aurora_mobile_api_workers | default(1) }}
