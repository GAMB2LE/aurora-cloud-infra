[Unit]
Description=Observe ASS and APS recovery transports without authenticating
After=network.target ssh.service

[Service]
Type=oneshot
User=nobody
Group=nogroup
ExecStart=/usr/local/bin/aurora-edge-access-status --timeout 3 --compact
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aurora-edge-access-status
